# --- Database ---
MONGODB_URI=mongodb://localhost:27017/knightfall

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-string

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
